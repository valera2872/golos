---
import ProductPlaceholder from './ProductPlaceholder.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  focus: string;
  variant?: 'home' | 'capture' | 'routine' | 'dreams';
}

const {
  eyebrow = 'One night system',
  title,
  text,
  focus,
  variant = 'dreams',
} = Astro.props;
---
<section class="section-tight seo-product-bridge">
  <div class="article-shell wide seo-bridge-grid">
    <div class="seo-bridge-visual">
      <ProductPlaceholder label={focus} caption="Product screenshot slot" variant={variant} />
    </div>
    <div class="seo-bridge-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <div class="seo-system-map" aria-label="Somnori product layers">
        <span><b>Capture</b><small>Thoughts · ideas · dreams</small></span>
        <span><b>Night</b><small>Time · voice alarm</small></span>
        <span><b>Routine</b><small>Sound · practices · autosuggestion</small></span>
        <span><b>Dreams</b><small>Morning · signs · lucid layer</small></span>
      </div>
      <a class="text-link" href="/#system">See the full Somnori night system →</a>
    </div>
  </div>
</section>
