---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneMockup from './PhoneMockup.astro';
import { copy, homeAlternates, homePath, type Locale } from '../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const base = homePath(locale);
const anchor = (id: string) => `${base}#${id}`;
---
<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  canonical={base}
  type="software"
  locale={locale}
  alternates={homeAlternates}
>
  <section class="hero hero-v2" id="product">
    <div class="shell hero-v2-grid">
      <div class="hero-copy hero-copy-v2">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="button primary" href={anchor('how-it-works')}>{t.hero.primary}</a>
          {locale === 'en' ? (
            <a class="button secondary" href="/dream-journal">{t.hero.secondary}</a>
          ) : (
            <a class="button secondary" href={anchor('morning')}>{t.hero.secondary}</a>
          )}
        </div>
        <p class="micro-note">{t.hero.note}</p>
      </div>
      <div class="hero-phone-stage">
        <div class="hero-glow"></div>
        <PhoneMockup variant="night" copy={t.phone} class="hero-phone" />
        <div class="floating-note float-one"><b>03:17</b><span>{t.proof[2].title}</span></div>
        <div class="floating-note float-two"><span class="pulse-dot"></span><span>{t.proof[0].title}</span></div>
      </div>
    </div>
  </section>

  <section class="section-tight proof-section">
    <div class="shell proof-strip proof-strip-v2">
      {t.proof.map((item) => (
        <div class="proof-item"><b>{item.title}</b><span>{item.text}</span></div>
      ))}
    </div>
  </section>

  <section class="section product-story" id="how-it-works">
    <div class="shell narrow-heading">
      <p class="eyebrow">{t.flow.eyebrow}</p>
      <h2>{t.flow.title}</h2>
      <p class="lead">{t.flow.lead}</p>
    </div>
    <div class="shell flow flow-v2">
      {t.flow.steps.map((step, index) => (
        <article class="flow-step flow-step-v2">
          <div class="flow-number">{index + 1}</div>
          <h3>{step.title}</h3>
          <p class="muted">{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split-showcase">
    <div class="shell showcase-grid">
      <div class="showcase-phones phone-offset-left">
        <PhoneMockup variant="night" copy={t.phone} />
      </div>
      <div class="showcase-copy">
        <p class="eyebrow">{t.capture.eyebrow}</p>
        <h2>{t.capture.title}</h2>
        <p class="lead">{t.capture.lead}</p>
        <ul class="feature-list">
          {t.capture.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
        {locale === 'en' && <a class="text-link" href="/hands-free-dream-journal">{t.capture.cta} →</a>}
      </div>
    </div>
  </section>

  <section class="section split-showcase soft-band" id="morning">
    <div class="shell showcase-grid reverse">
      <div class="showcase-copy">
        <p class="eyebrow">{t.morning.eyebrow}</p>
        <h2>{t.morning.title}</h2>
        <p class="lead">{t.morning.lead}</p>
        <ul class="feature-list">
          {t.morning.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
      </div>
      <div class="showcase-phones phone-offset-right">
        <PhoneMockup variant="morning" copy={t.phone} />
      </div>
    </div>
  </section>

  <section class="section split-showcase" id="learn">
    <div class="shell showcase-grid">
      <div class="showcase-phones phone-offset-left">
        <PhoneMockup variant="signs" copy={t.phone} />
      </div>
      <div class="showcase-copy">
        <p class="eyebrow">{t.signs.eyebrow}</p>
        <h2>{t.signs.title}</h2>
        <p class="lead">{t.signs.lead}</p>
        <ul class="feature-list">
          {t.signs.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
        {locale === 'en' && <a class="text-link" href="/remember-dreams">How dream recall becomes a history →</a>}
      </div>
    </div>
  </section>

  <section class="section split-showcase soft-band">
    <div class="shell showcase-grid reverse">
      <div class="showcase-copy">
        <p class="eyebrow">{t.beforeSleep.eyebrow}</p>
        <h2>{t.beforeSleep.title}</h2>
        <p class="lead">{t.beforeSleep.lead}</p>
        <ul class="feature-list">
          {t.beforeSleep.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
      </div>
      <div class="showcase-phones phone-offset-right">
        <PhoneMockup variant="sleep" copy={t.phone} />
      </div>
    </div>
  </section>

  <section class="section privacy-section" id="privacy">
    <div class="shell privacy-card">
      <div>
        <p class="eyebrow">{t.privacy.eyebrow}</p>
        <h2>{t.privacy.title}</h2>
        <p class="lead">{t.privacy.lead}</p>
      </div>
      <div class="privacy-symbol" aria-hidden="true"><span>◐</span><i></i></div>
    </div>
  </section>

  <section class="section final-section" id="app">
    <div class="shell final-card">
      <div class="final-copy">
        <p class="eyebrow">{t.final.eyebrow}</p>
        <h2>{t.final.title}</h2>
        <p class="lead">{t.final.lead}</p>
        <a class="button primary" href={anchor('how-it-works')}>{t.final.cta}</a>
      </div>
      <PhoneMockup variant="morning" copy={t.phone} class="final-phone" />
    </div>
  </section>
</BaseLayout>
