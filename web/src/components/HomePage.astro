---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPlaceholder from './ProductPlaceholder.astro';
import { homePath } from '../i18n/site';
import { publicHomeAlternates, type PublicLocale } from '../i18n/public';
import { homeV22 } from '../i18n/home-v22';

interface Props { locale: PublicLocale }
const { locale } = Astro.props;
const t = homeV22[locale];
const base = homePath(locale);
const anchor = (id: string) => `${base}#${id}`;
---
<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  canonical={base}
  type="software"
  locale={locale}
  alternates={publicHomeAlternates}
>
  <section class="hero hero-v22" id="product">
    <div class="shell hero-v22-grid">
      <div class="hero-copy hero-copy-v22">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="button primary" href={anchor('capture')}>{t.hero.primary}</a>
          <a class="button secondary" href={anchor('dreams')}>{t.hero.secondary}</a>
        </div>
        <p class="micro-note">{t.hero.note}</p>
        <div class={`availability-note ${locale === 'en' ? 'english-pending' : 'russian-current'}`}>
          <span class="availability-dot"></span>{t.hero.availability}
        </div>
      </div>
      <div class="hero-product-stage">
        <div class="hero-glow"></div>
        <ProductPlaceholder label={t.placeholder.home} caption={t.placeholder.caption} variant="home" class="hero-placeholder" />
        <div class="hero-mini-chip chip-thought">✦ <span>{t.pillars[0].title}</span></div>
        <div class="hero-mini-chip chip-time">◷ <span>{t.pillars[1].title}</span></div>
        <div class="hero-mini-chip chip-routine">◐ <span>{t.pillars[2].title}</span></div>
      </div>
    </div>
  </section>

  <section class="section-tight pillars-section" id="system">
    <div class="shell night-pillars">
      {t.pillars.map((pillar) => (
        <article class="night-pillar">
          <span class="pillar-icon">{pillar.icon}</span>
          <div><h3>{pillar.title}</h3><p>{pillar.text}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section split-showcase" id="capture">
    <div class="shell showcase-grid">
      <div class="showcase-phones phone-offset-left">
        <ProductPlaceholder label={t.placeholder.capture} caption={t.placeholder.caption} variant="capture" />
      </div>
      <div class="showcase-copy">
        <p class="eyebrow">{t.capture.eyebrow}</p>
        <h2>{t.capture.title}</h2>
        <p class="lead">{t.capture.lead}</p>
        <blockquote class="product-quote">{t.capture.quote}</blockquote>
        <ul class="feature-list">
          {t.capture.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
        {locale === 'en' ? (
          <a class="text-link" href="/night-thought-recorder">Night thoughts & ideas →</a>
        ) : (
          <a class="text-link" href="/ru/zapis-mysley-golosom">Запись мыслей и идей ночью →</a>
        )}
      </div>
    </div>
  </section>

  <section class="section soft-band handsfree-section" id="night-utilities">
    <div class="shell narrow-heading">
      <p class="eyebrow">{t.handsFree.eyebrow}</p>
      <h2>{t.handsFree.title}</h2>
      <p class="lead">{t.handsFree.lead}</p>
    </div>
    <div class="shell utility-grid">
      {t.handsFree.cards.map((card, index) => (
        <article class="utility-card">
          <span class="utility-icon">{index === 0 ? '◷' : index === 1 ? '◴' : '◐'}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
    <div class="shell" style="margin-top:26px;text-align:center">
      {locale === 'en' ? (
        <a class="text-link" href="/voice-alarm-at-night">Voice alarm & time at night →</a>
      ) : (
        <a class="text-link" href="/ru/golosovoy-budilnik">Голосовой будильник и время ночью →</a>
      )}
    </div>
  </section>

  <section class="section split-showcase" id="routine">
    <div class="shell showcase-grid reverse">
      <div class="showcase-copy">
        <p class="eyebrow">{t.bedtime.eyebrow}</p>
        <h2>{t.bedtime.title}</h2>
        <p class="lead">{t.bedtime.lead}</p>
        <div class="protocol-list">
          {t.bedtime.steps.map((step, index) => (
            <div class="protocol-step">
              <span>{index + 1}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </div>
          ))}
        </div>
        <p class="truth-note">{t.bedtime.note}</p>
        <div class="inline-guide-links">
          {locale === 'en' ? (
            <>
              <a class="text-link" href="/bedtime-routine-app">Bedtime routine app →</a>
              <a class="text-link" href="/sleep-affirmations-app">Sleep affirmations & autosuggestion →</a>
            </>
          ) : (
            <>
              <a class="text-link" href="/ru/ritual-pered-snom">Ритуал перед сном →</a>
              <a class="text-link" href="/ru/affirmacii-pered-snom">Аффирмации и самовнушение →</a>
            </>
          )}
        </div>
      </div>
      <div class="showcase-phones phone-offset-right">
        <ProductPlaceholder label={t.placeholder.routine} caption={t.placeholder.caption} variant="routine" />
      </div>
    </div>
  </section>

  <section class="section wake-section">
    <div class="shell wake-card">
      <div class="wake-copy">
        <div class="future-label"><span>{t.wake.badge}</span></div>
        <p class="eyebrow">{t.wake.eyebrow}</p>
        <h2>{t.wake.title}</h2>
        <p class="lead">{t.wake.lead}</p>
        <p class="truth-note">{t.wake.note}</p>
      </div>
      <div class="wake-chain" aria-label={t.wake.title}>
        {t.wake.chain.map((item, index) => (
          <div class="wake-node">
            <span>{index + 1}</span><b>{item}</b>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section split-showcase soft-band" id="dreams">
    <div class="shell showcase-grid">
      <div class="showcase-phones phone-offset-left">
        <ProductPlaceholder label={t.placeholder.dreams} caption={t.placeholder.caption} variant="dreams" />
      </div>
      <div class="showcase-copy">
        <p class="eyebrow">{t.dreams.eyebrow}</p>
        <h2>{t.dreams.title}</h2>
        <p class="lead">{t.dreams.lead}</p>
        <ul class="feature-list">
          {t.dreams.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}
        </ul>
        {locale === 'en' ? (
          <a class="text-link" href="/dream-journal">{t.dreams.cta} →</a>
        ) : (
          <div class="inline-guide-links">
            <a class="text-link" href="/ru/dnevnik-snov">Дневник снов →</a>
            <a class="text-link" href="/ru/kak-zapominat-sny">Как запоминать сны →</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section capability-section" id="capabilities">
    <div class="shell narrow-heading">
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2>{t.features.title}</h2>
      <p class="lead">{t.features.lead}</p>
    </div>
    <div class="shell capability-grid">
      {t.features.items.map((item) => (
        <article class={`capability-card ${item.status}`}>
          <div class="capability-top">
            <span class={`status-tag ${item.status}`}>{item.status === 'current' ? t.features.current : t.features.next}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section privacy-section" id="privacy">
    <div class="shell privacy-card">
      <div>
        <p class="eyebrow">{t.privacy.eyebrow}</p>
        <h2>{t.privacy.title}</h2>
        <p class="lead">{t.privacy.lead}</p>
      </div>
      <div class="privacy-symbol" aria-hidden="true"><span>◐</span><i></i></div>
    </div>
  </section>

  <section class="section final-section" id="app">
    <div class="shell final-card final-card-v22">
      <div class="final-copy">
        <p class="eyebrow">{t.final.eyebrow}</p>
        <h2>{t.final.title}</h2>
        <p class="lead">{t.final.lead}</p>
        <a class="button primary" href={anchor('capture')}>{t.final.cta}</a>
      </div>
      <div class="night-arc" aria-hidden="true"><span>✦</span><span>◷</span><span>◐</span><span>☾</span></div>
    </div>
  </section>
</BaseLayout>
