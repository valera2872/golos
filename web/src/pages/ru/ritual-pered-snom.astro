---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoProductBridge from '../../components/SeoProductBridge.astro';

const title = 'Ритуал перед сном в одном приложении | Somnori';
const description = 'Соберите личный ритуал перед сном: звук, практика, самовнушение и готовый ночной режим Somnori в одной последовательности.';
const alternates = [
  { lang: 'en', href: '/bedtime-routine-app' },
  { lang: 'ru', href: '/ru/ritual-pered-snom' },
];
---
<BaseLayout title={title} description={description} canonical="/ru/ritual-pered-snom" type="software" locale="ru" alternates={alternates}>
  <section class="article-hero">
    <div class="article-shell wide">
      <div class="breadcrumbs"><a href="/ru/">Somnori</a> / Ритуал перед сном</div>
      <p class="eyebrow">Личный вечерний сценарий</p>
      <h1>Соберите свой ритуал перед сном в одном приложении.</h1>
      <p class="lead">Музыка, звук природы, короткая практика, самовнушение и готовый Ночной помощник могут быть не отдельными кнопками, а одной понятной последовательностью перед сном.</p>
      <div class="actions">
        <a class="button primary" href="#example">Пример сценария</a>
        <a class="button secondary" href="/ru/affirmacii-pered-snom">Самовнушение перед сном</a>
      </div>
    </div>
  </section>

  <section class="section-tight" id="example">
    <div class="article-shell wide">
      <div class="flow">
        <div class="flow-step"><div class="flow-number">1</div><h3>Звук</h3><p class="muted">Спокойная музыка или ночной лес.</p></div>
        <div class="flow-step"><div class="flow-number">2</div><h3>Практика</h3><p class="muted">Короткий выбранный сценарий перед сном.</p></div>
        <div class="flow-step"><div class="flow-number">3</div><h3>Самовнушение</h3><p class="muted">Своя фраза, намерение или готовая запись.</p></div>
        <div class="flow-step"><div class="flow-number">4</div><h3>Ночной режим</h3><p class="muted">Somnori остаётся готовым к времени, будильнику, мыслям и снам.</p></div>
      </div>
    </div>
  </section>

  <SeoProductBridge
    locale="ru"
    eyebrow="Слой подготовки"
    title="Ритуал перед сном ценен не как библиотека контента, а как повторяемый сценарий."
    text="Somnori соединяет подготовку ко сну с тем, что происходит позже: ночными голосовыми командами, записью мыслей, будильником и утренним возвращением к ночи."
    focus="Ритуал перед сном"
    variant="routine"
  />

  <article class="article-shell prose section-tight">
    <h2>Что такое ритуал перед сном в Somnori</h2>
    <p>Это не обязательная «правильная» последовательность и не медицинская программа сна. Это ваш заранее выбранный набор действий, который не приходится каждый вечер собирать заново по разным приложениям.</p>

    <h2>Из чего он может состоять</h2>
    <ul>
      <li>спокойная музыка или звуки природы;</li>
      <li>короткая практика внимания или расслабления;</li>
      <li>самовнушение, аффирмация или личное намерение;</li>
      <li>намерение запомнить сон или подготовка к осознанному сновидению;</li>
      <li>переход в Ночной помощник.</li>
    </ul>

    <h2>Почему один сценарий лучше набора несвязанных кнопок</h2>
    <p>Когда каждый элемент живёт отдельно, пользователь каждый вечер снова принимает решения: что включить, что открыть следующим, когда остановиться. Протокол превращает это в знакомую последовательность и делает Somnori системой всей ночи, а не каталогом аудио.</p>

    <h2>Somnori не хочет конкурировать количеством медитаций</h2>
    <p>Большие приложения для сна выигрывают библиотеками из сотен треков, историй и медитаций. Наше преимущество в другом: пользователь собирает свой небольшой персональный сценарий и затем остаётся в том же приложении всю ночь.</p>

    <h2>Ритуал может быть очень коротким</h2>
    <p>Например: ночной лес → короткое самовнушение → Ночной помощник. Или музыка → намерение запомнить сон → ночь. Ценность не в количестве шагов, а в том, что они заранее выбраны.</p>

    <h2>Следующий шаг продукта — протокол пробуждения</h2>
    <p>Логичное продолжение той же идеи: будильник → выбранный звук → самовнушение или практика после пробуждения. Этот сценарий относится к roadmap и пока должен быть явно отделён от уже работающих функций.</p>

    <h2>Связанные страницы</h2>
    <p>Для отдельной работы с личными фразами смотрите <a href="/ru/affirmacii-pered-snom">аффирмации и самовнушение перед сном</a>. Для ночных команд — <a href="/ru/golosovoy-budilnik">голосовой будильник и время без рук</a>.</p>
  </article>

  <section class="section-tight">
    <div class="article-shell wide callout">
      <p class="eyebrow">Ваш сценарий</p>
      <h2>Не ещё одно приложение для сна. Один маршрут через вечер и ночь.</h2>
      <p class="lead">Somnori становится полезнее, когда вечерняя подготовка, ночь и утро связаны между собой.</p>
      <div class="actions"><a class="button primary" href="/ru/#routine">Посмотреть вечерний слой Somnori</a></div>
    </div>
  </section>
</BaseLayout>
