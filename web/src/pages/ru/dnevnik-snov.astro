---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoProductBridge from '../../components/SeoProductBridge.astro';

const title = 'Дневник снов и сновидений для Android | Somnori';
const description = 'Дневник снов Somnori соединяет ночную голосовую запись, исходное аудио, утренний обзор и личную историю сновидений в одном Android-приложении.';
const alternates = [
  { lang: 'en', href: '/dream-journal' },
  { lang: 'ru', href: '/ru/dnevnik-snov' },
];
---
<BaseLayout title={title} description={description} canonical="/ru/dnevnik-snov" type="software" locale="ru" alternates={alternates}>
  <section class="article-hero">
    <div class="article-shell wide">
      <div class="breadcrumbs"><a href="/ru/">Somnori</a> / Дневник снов</div>
      <p class="eyebrow">Дневник снов и сновидений</p>
      <h1>Дневник снов, который начинается ещё ночью.</h1>
      <p class="lead">Запись сна — только первый шаг. Somnori связывает момент пробуждения, исходный голос, утренний обзор и историю повторяющихся деталей в один ночной цикл.</p>
      <div class="actions">
        <a class="button primary" href="/ru/zapis-snov-golosom">Запись снов голосом</a>
        <a class="button secondary" href="/ru/kak-zapominat-sny">Как запоминать сны</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="article-shell wide">
      <div class="loop">
        <div class="loop-item"><b>Перед сном</b><span>Подготовить ночь, звук или намерение.</span></div>
        <div class="loop-item"><b>Ночью</b><span>Сохранить сон с минимальным взаимодействием с экраном.</span></div>
        <div class="loop-item"><b>Утром</b><span>Вернуться к записям уже полностью проснувшись.</span></div>
        <div class="loop-item"><b>История</b><span>Замечать повторяющиеся детали и личные признаки сна.</span></div>
      </div>
    </div>
  </section>

  <SeoProductBridge
    locale="ru"
    eyebrow="Слой сновидений"
    title="Дневник снов — крупная часть Somnori, но не граница продукта."
    text="Тот же Somnori ночью сохраняет мысли и идеи, сообщает время, управляет будильником и продолжает вечерний сценарий. Дневник сновидений добавляет к этой системе память о самих снах."
    focus="Дневник снов"
    variant="dreams"
  />

  <article class="article-shell prose section-tight">
    <h2>Что должен решать современный дневник снов</h2>
    <p>Хранить уже написанную запись умеет почти любое приложение заметок. Более сложная задача появляется раньше: успеть сохранить сон в первые минуты после пробуждения, когда память ещё хрупкая и не хочется полноценно включаться в телефон.</p>
    <p>Поэтому Somnori рассматривает <strong>ночную запись → утро → личную историю</strong> как один сценарий.</p>

    <h2>Ночная запись важнее красивого оформления</h2>
    <p>Сон может начинаться как короткий голосовой фрагмент: место, человек, странное событие, эмоция. Не нужно сразу превращать его в связный текст. Исходное аудио сохраняет формулировку, с которой вы проснулись.</p>

    <h2>Утром начинается другая работа</h2>
    <p>Ночью интерфейс должен требовать как можно меньше внимания. Утром можно спокойно увидеть, что было записано, дополнить детали и решить, какие записи действительно были снами.</p>

    <h2>История важнее одного толкования</h2>
    <p>Один сон может быть интересным. Серия снов даёт другой уровень контекста: повторяющиеся места, люди, эмоции и невозможные ситуации становятся частью именно вашей истории, а не универсального списка символов.</p>

    <h2>Признаки сна и осознанные сновидения</h2>
    <p>Повторяющаяся деталь может стать личным признаком сна и использоваться в практике осознанных сновидений. Somnori уже развивает этот слой вокруг собственной истории пользователя, а не вокруг абстрактного «сонника».</p>

    <h2>Что насчёт ИИ-толкования</h2>
    <p>ИИ может помогать структурировать запись, задавать вопросы и замечать повторения. Но Somnori не должен выдавать универсальный символ за точный психологический диагноз. Будущий Dream Intelligence должен опираться прежде всего на историю самого пользователя.</p>

    <h2>Somnori — не только дневник сновидений</h2>
    <p>Это важное отличие новой архитектуры продукта. Пользователь может почти не интересоваться толкованием снов и всё равно использовать Somnori для <a href="/ru/zapis-mysley-golosom">ночных идей</a>, <a href="/ru/golosovoy-budilnik">времени и будильника</a> или <a href="/ru/ritual-pered-snom">личного ритуала перед сном</a>.</p>

    <h2>Кому подойдёт такой дневник</h2>
    <ul>
      <li>тем, кто забывает сон, пока открывает телефон;</li>
      <li>тем, кому проще говорить ночью, чем печатать;</li>
      <li>тем, кто хочет хранить исходные голосовые записи;</li>
      <li>тем, кому интересны повторяющиеся признаки и осознанные сновидения;</li>
      <li>тем, кто хочет связать сон с остальной ночной системой, а не держать отдельное приложение только для дневника.</li>
    </ul>
  </article>

  <section class="section-tight">
    <div class="article-shell wide callout">
      <p class="eyebrow">Начните с сохранения</p>
      <h2>Первый полезный сон — тот, который вы успели записать.</h2>
      <p class="lead">Посмотрите, как Somnori сокращает путь между пробуждением и сохранённой записью.</p>
      <div class="actions"><a class="button primary" href="/ru/beskontaktnaya-zapis-snov">Бесконтактная запись сна</a></div>
    </div>
  </section>
</BaseLayout>
