---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Somnori" description="The requested Somnori page was not found." canonical="/404" type="website" noindex={true}>
  <section class="article-hero">
    <div class="article-shell">
      <p class="eyebrow">404</p>
      <h1>This page faded before we could save it.</h1>
      <p class="lead">The link may be old, or the page may not exist yet.</p>
      <div class="actions">
        <a class="button primary" href="/">Go to Somnori</a>
        <a class="button secondary" href="/remember-dreams">Read about dream recall</a>
      </div>
    </div>
  </section>
</BaseLayout>
