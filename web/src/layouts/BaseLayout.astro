---
import '../styles/global.css';
import '../styles/v2.css';
import { copy, homePath, localeMeta, locales, type Locale } from '../i18n/site';

interface Alternate { lang: string; href: string }

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article' | 'software';
  noindex?: boolean;
  locale?: Locale;
  alternates?: Alternate[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  type = 'website',
  noindex = false,
  locale = 'en',
  alternates = [],
} = Astro.props;

const site = 'https://somnori.com';
const normalizeUrl = (href: string) => {
  const value = new URL(href, site).toString();
  return value !== `${site}/` && value.endsWith('/') ? value.slice(0, -1) : value;
};
const canonicalUrl = normalizeUrl(canonical);
const ogType = type === 'article' ? 'article' : 'website';
const t = copy[locale];
const base = homePath(locale);
const anchor = (id: string) => `${base}#${id}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Somnori',
  url: site,
};

const softwareSchema = type === 'software' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Somnori',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  url: canonicalUrl,
  description,
} : null;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070816" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={normalizeUrl(alternate.href)} />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={`${site}/`} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Somnori" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {softwareSchema && <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={base} aria-label="Somnori home"><span class="brand-mark">◐</span>Somnori</a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={anchor('product')}>{t.nav.product}</a>
          <a href={anchor('how-it-works')}>{t.nav.how}</a>
          <a href={anchor('morning')}>{t.nav.morning}</a>
          <a href={anchor('learn')}>{t.nav.learn}</a>
        </nav>
        <details class="language-switcher">
          <summary aria-label={t.nav.language}><span class="globe">◎</span>{localeMeta[locale].native}<span class="chevron">⌄</span></summary>
          <div class="language-menu">
            {locales.map((lang) => (
              <a class={lang === locale ? 'active' : ''} href={localeMeta[lang].path} lang={lang} hreflang={lang}>
                <span>{localeMeta[lang].native}</span><b>{localeMeta[lang].label}</b>
              </a>
            ))}
          </div>
        </details>
        <a class="nav-cta" href={anchor('app')}>{t.nav.app}</a>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid footer-grid-v2">
          <div>
            <div class="brand"><span class="brand-mark">◐</span>Somnori</div>
            <p class="footer-copy">{t.footer.tagline}</p>
          </div>
          <div>
            <div class="footer-title">{t.footer.product}</div>
            <div class="footer-links">
              <a href={anchor('how-it-works')}>{t.nav.how}</a>
              <a href={anchor('morning')}>{t.nav.morning}</a>
              <a href={anchor('learn')}>{t.nav.learn}</a>
            </div>
          </div>
          <div>
            <div class="footer-title">{t.footer.learn}</div>
            <div class="footer-links">
              {locale === 'en' ? (
                <>
                  <a href="/remember-dreams">How to Remember Dreams</a>
                  <a href="/voice-dream-journal">Voice Dream Journal</a>
                  <a href="/hands-free-dream-journal">Hands-Free Capture</a>
                </>
              ) : (
                <>
                  <a href={anchor('product')}>{t.nav.product}</a>
                  <a href={anchor('learn')}>{t.signs.eyebrow}</a>
                  <a href={anchor('privacy')}>{t.privacy.eyebrow}</a>
                </>
              )}
            </div>
          </div>
          <div>
            <div class="footer-title">{t.footer.legal}</div>
            <div class="footer-links">
              <a href="/privacy">{t.footer.privacy}</a>
              <a href="/terms">{t.footer.terms}</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Somnori</span>
          <span>{t.footer.global}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
