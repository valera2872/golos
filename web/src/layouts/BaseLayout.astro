---
import '../styles/global.css';
import '../styles/v2.css';
import '../styles/v21.css';
import '../styles/v22.css';
import '../styles/v24.css';
import { copy, homePath, localeMeta, type Locale } from '../i18n/site';
import { publicLocales, isPublicLocale } from '../i18n/public';
import { homeV22 } from '../i18n/home-v22';

interface Alternate { lang: string; href: string }

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article' | 'software';
  noindex?: boolean;
  locale?: Locale;
  alternates?: Alternate[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  type = 'website',
  noindex = false,
  locale = 'en',
  alternates = [],
} = Astro.props;

const site = 'https://somnori.com';
const normalizeUrl = (href: string) => {
  const value = new URL(href, site).toString();
  return value !== `${site}/` && value.endsWith('/') ? value.slice(0, -1) : value;
};

const alternatePairs: Record<string, Alternate[]> = {
  '/night-thought-recorder': [
    { lang: 'en', href: '/night-thought-recorder' },
    { lang: 'ru', href: '/ru/zapis-mysley-golosom' },
  ],
  '/voice-alarm-at-night': [
    { lang: 'en', href: '/voice-alarm-at-night' },
    { lang: 'ru', href: '/ru/golosovoy-budilnik' },
  ],
  '/bedtime-routine-app': [
    { lang: 'en', href: '/bedtime-routine-app' },
    { lang: 'ru', href: '/ru/ritual-pered-snom' },
  ],
  '/sleep-affirmations-app': [
    { lang: 'en', href: '/sleep-affirmations-app' },
    { lang: 'ru', href: '/ru/affirmacii-pered-snom' },
  ],
};

const canonicalPath = new URL(canonical, site).pathname.replace(/\/$/, '') || '/';
const effectiveAlternates = alternates.length > 0 ? alternates : (alternatePairs[canonicalPath] ?? []);
const canonicalUrl = normalizeUrl(canonical);
const ogType = type === 'article' ? 'article' : 'website';
const legacy = copy[locale];
const publicCopy = isPublicLocale(locale) ? homeV22[locale] : null;
const base = homePath(locale);
const anchor = (id: string) => `${base}#${id}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Somnori',
  url: site,
};

const softwareSchema = type === 'software' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Somnori',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  url: canonicalUrl,
  description,
} : null;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070816" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {effectiveAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={normalizeUrl(alternate.href)} />
    ))}
    {effectiveAlternates.length > 0 && <link rel="alternate" hreflang="x-default" href={`${site}/`} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Somnori" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {softwareSchema && <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{legacy.skip}</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={base} aria-label="Somnori home"><span class="brand-mark">◐</span>Somnori</a>
        <nav class="main-nav" aria-label="Main navigation">
          {publicCopy ? (
            <>
              <a href={anchor('product')}>{publicCopy.nav.product}</a>
              <a href={anchor('capture')}>{publicCopy.nav.capture}</a>
              <a href={anchor('routine')}>{publicCopy.nav.routine}</a>
              <a href={anchor('dreams')}>{publicCopy.nav.dreams}</a>
            </>
          ) : (
            <>
              <a href={anchor('product')}>{legacy.nav.product}</a>
              <a href={anchor('how-it-works')}>{legacy.nav.how}</a>
              <a href={anchor('morning')}>{legacy.nav.morning}</a>
              <a href={anchor('learn')}>{legacy.nav.learn}</a>
            </>
          )}
        </nav>
        <details class="language-switcher">
          <summary aria-label={publicCopy?.nav.language ?? legacy.nav.language}><span class="globe">◎</span>{localeMeta[locale].native}<span class="chevron">⌄</span></summary>
          <div class="language-menu">
            {publicLocales.map((lang) => (
              <a class={lang === locale ? 'active' : ''} href={localeMeta[lang].path} lang={lang} hreflang={lang}>
                <span>{localeMeta[lang].native}</span><b>{localeMeta[lang].label}</b>
              </a>
            ))}
          </div>
        </details>
        <a class="nav-cta" href={anchor('app')}>{publicCopy?.nav.app ?? legacy.nav.app}</a>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        {publicCopy ? (
          <>
            <div class="footer-grid footer-grid-v2">
              <div>
                <div class="brand"><span class="brand-mark">◐</span>Somnori</div>
                <p class="footer-copy">{publicCopy.footer.tagline}</p>
              </div>
              <div>
                <div class="footer-title">{publicCopy.footer.product}</div>
                <div class="footer-links">
                  <a href={anchor('capture')}>{publicCopy.nav.capture}</a>
                  <a href={anchor('routine')}>{publicCopy.nav.routine}</a>
                  <a href={anchor('dreams')}>{publicCopy.nav.dreams}</a>
                </div>
              </div>
              <div>
                <div class="footer-title">{publicCopy.footer.explore}</div>
                <div class="footer-links">
                  {locale === 'en' ? (
                    <>
                      <a href="/night-thought-recorder">Night Thought Recorder</a>
                      <a href="/voice-alarm-at-night">Voice Alarm at Night</a>
                      <a href="/bedtime-routine-app">Bedtime Routine</a>
                      <a href="/dream-journal">Dream Journal</a>
                    </>
                  ) : (
                    <>
                      <a href="/ru/zapis-mysley-golosom">Запись мыслей голосом</a>
                      <a href="/ru/golosovoy-budilnik">Голосовой будильник</a>
                      <a href="/ru/ritual-pered-snom">Ритуал перед сном</a>
                      <a href="/ru/affirmacii-pered-snom">Аффирмации перед сном</a>
                    </>
                  )}
                </div>
              </div>
              <div>
                <div class="footer-title">{publicCopy.footer.legal}</div>
                <div class="footer-links">
                  <a href="/privacy">{publicCopy.footer.privacy}</a>
                  <a href="/terms">{publicCopy.footer.terms}</a>
                </div>
              </div>
            </div>
            <div class="footer-bottom">
              <span>© {new Date().getFullYear()} Somnori</span>
              <span>{publicCopy.footer.global}</span>
            </div>
          </>
        ) : (
          <>
            <div class="footer-grid footer-grid-v2">
              <div>
                <div class="brand"><span class="brand-mark">◐</span>Somnori</div>
                <p class="footer-copy">{legacy.footer.tagline}</p>
              </div>
              <div>
                <div class="footer-title">{legacy.footer.product}</div>
                <div class="footer-links">
                  <a href={anchor('how-it-works')}>{legacy.nav.how}</a>
                  <a href={anchor('morning')}>{legacy.nav.morning}</a>
                  <a href={anchor('learn')}>{legacy.nav.learn}</a>
                </div>
              </div>
              <div>
                <div class="footer-title">{legacy.footer.learn}</div>
                <div class="footer-links">
                  <a href="/remember-dreams">How to Remember Dreams</a>
                  <a href="/voice-dream-journal">Voice Dream Journal</a>
                  <a href="/hands-free-dream-journal">Hands-Free Capture</a>
                </div>
              </div>
              <div>
                <div class="footer-title">{legacy.footer.legal}</div>
                <div class="footer-links">
                  <a href="/privacy">{legacy.footer.privacy}</a>
                  <a href="/terms">{legacy.footer.terms}</a>
                </div>
              </div>
            </div>
            <div class="footer-bottom"><span>© {new Date().getFullYear()} Somnori</span><span>{legacy.footer.global}</span></div>
          </>
        )}
      </div>
    </footer>
  </body>
</html>
