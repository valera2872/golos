<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_background"
            android:text="VOICE LAB · БЕСПЛАТНО"
            android:textColor="@color/qd_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Найдём живой голос Somnori"
            android:textColor="@color/qd_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="2dp"
            android:text="Сравните все русские голоса, которые уже есть на этом телефоне. Можно менять скорость и высоту, слушать реальный текст будильника и сохранить лучший офлайн-вариант без подписки и облака."
            android:textColor="@color/qd_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/voiceLabEngineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ищу голоса на этом телефоне…"
            android:textColor="@color/qd_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background"
                android:text="1 · ГОЛОС"
                android:textColor="@color/qd_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceLabVoiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="Голос загружается…"
                android:textColor="@color/qd_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceLabVoiceMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text=""
                android:textColor="@color/qd_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voiceLabPrevButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="‹ Предыдущий"
                    android:textAllCaps="false"
                    android:textColor="@color/qd_text"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voiceLabNextButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Следующий ›"
                    android:textAllCaps="false"
                    android:textColor="@color/qd_text"
                    app:cornerRadius="17dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Сетевые голоса можно прослушать, но для ночного будильника Somnori сохраняет только установленный офлайн-голос."
                android:textColor="@color/qd_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background"
                android:text="2 · ПОДАЧА"
                android:textColor="@color/qd_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceLabRateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="Скорость · 0.82"
                android:textColor="@color/qd_text"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/voiceLabRateSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50" />

            <TextView
                android:id="@+id/voiceLabPitchLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Высота голоса · 0.97"
                android:textColor="@color/qd_text"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/voiceLabPitchSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background"
                android:text="3 · СЛУШАЕМ"
                android:textColor="@color/qd_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="Те же фразы, которые важны ночью"
                android:textColor="@color/qd_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabTimeButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="Произнести текущее время"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabAlarmConfirmButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:text="«Хорошо. Будильник на семь тридцать»"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabWakeButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:text="Мой реальный текст будильника"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabMorningButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:text="Доброе утро"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="17dp" />

            <EditText
                android:id="@+id/voiceLabCustomText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:backgroundTint="@color/qd_border_bright"
                android:hint="Своя тестовая фраза"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="54dp"
                android:padding="10dp"
                android:textColor="@color/qd_text"
                android:textColorHint="@color/qd_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabCustomButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Произнести мою фразу"
                android:textAllCaps="false"
                android:textColor="@color/qd_primary_dark"
                app:backgroundTint="@color/qd_primary"
                app:cornerRadius="17dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background"
                android:text="4 · ВЫБОР"
                android:textColor="@color/qd_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceLabSavedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:lineSpacingExtra="2dp"
                android:text="Сейчас: автоматический выбор"
                android:textColor="@color/qd_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabApplyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:minHeight="52dp"
                android:text="Использовать этот голос в Somnori"
                android:textAllCaps="false"
                android:textColor="@color/qd_primary_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/qd_primary"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceLabResetButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Вернуть автоматический выбор · 0.82 / 0.97"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="17dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Сохранённый профиль применяется к голосу времени и к тексту будильника при следующем запуске этих функций."
                android:textColor="@color/qd_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceLabBackButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="50dp"
            android:text="Назад в настройки"
            android:textAllCaps="false"
            android:textColor="@color/qd_text"
            app:cornerRadius="18dp" />
    </LinearLayout>
</ScrollView>
