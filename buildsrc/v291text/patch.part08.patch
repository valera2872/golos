+package com.quietdiary.app;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.ArrayDeque;
+
+/** Small VAD-only collector for the second turn of a hands-free voice dialog. */
+public final class VoiceUtteranceCollector {
+    private static final int SAMPLE_RATE = 16000;
+    private static final int MIN_SAMPLES = SAMPLE_RATE / 4;
+    private static final int MAX_SAMPLES = SAMPLE_RATE * 8;
+    private static final int END_SILENCE_BLOCKS = 9;
+
+    private final ArrayDeque<short[]> preRoll = new ArrayDeque<>();
+    private final ByteArrayOutputStream segment = new ByteArrayOutputStream();
+    private boolean speaking;
+    private int silentBlocks;
+    private double noiseFloor = 260.0;
+
+    /** Returns a finished utterance once, otherwise null. */
+    public synchronized short[] accept(short[] buffer, int count) {
+        double rms = AudioFingerprint.rms(buffer, 0, count);
+        double startThreshold = Math.max(430.0, noiseFloor * 2.25 + 90.0);
+        double endThreshold = Math.max(320.0, noiseFloor * 1.50 + 55.0);
+
+        if (!speaking && rms < startThreshold) {
+            noiseFloor = noiseFloor * 0.985 + rms * 0.015;
+            addPreRoll(buffer, count);
+            return null;
+        }
+        if (!speaking) {
+            speaking = true;
+            silentBlocks = 0;
+            segment.reset();
+            try {
+                for (short[] block : preRoll) segment.write(WakeTemplateStore.shortsToBytes(block, block.length));
+            } catch (IOException ignored) { }
+            preRoll.clear();
+        }
+        try { segment.write(WakeTemplateStore.shortsToBytes(buffer, count)); }
+        catch (IOException ignored) { }
+        if (rms < endThreshold) silentBlocks++; else silentBlocks = 0;
+        int samples = segment.size() / 2;
+        if ((samples >= MIN_SAMPLES && silentBlocks >= END_SILENCE_BLOCKS) || samples >= MAX_SAMPLES) {
+            short[] result = bytesToShorts(segment.toByteArray());
+            reset();
+            return result.length >= MIN_SAMPLES ? result : null;
+        }
+        return null;
+    }
+
+    public synchronized void reset() {
+        speaking = false;
+        silentBlocks = 0;
+        segment.reset();
+        preRoll.clear();
+    }
+
+    private void addPreRoll(short[] buffer, int count) {
+        preRoll.addLast(java.util.Arrays.copyOf(buffer, count));
+        while (preRoll.size() > 3) preRoll.removeFirst();
+    }
+
+    private static short[] bytesToShorts(byte[] bytes) {
+        short[] result = new short[bytes.length / 2];
+        for (int i = 0; i < result.length; i++)
+            result[i] = (short) ((bytes[i * 2] & 0xff) | (bytes[i * 2 + 1] << 8));
+        return result;
+    }
+}
