+    private static List<Integer> parseNumberWords(List<String> words) {
+        List<Integer> result = new ArrayList<>();
+        int i = 0;
+        while (i < words.size()) {
+            String word = words.get(i);
+            Integer small = SMALL.get(word);
+            Integer tens = TENS.get(word);
+            if (tens != null) {
+                int value = tens;
+                if (i + 1 < words.size()) {
+                    Integer unit = SMALL.get(words.get(i + 1));
+                    if (unit != null && unit >= 1 && unit <= 9) {
+                        value += unit;
+                        i++;
+                    }
+                }
+                result.add(value);
+            } else if (small != null) {
+                result.add(small);
+            }
+            i++;
+        }
+        return result;
+    }
+
+    private static Result validateTime(int hour, int minute, String normalized) {
+        if (hour < 0 || hour > 23) return unknown(normalized, "Часы должны быть от нуля до двадцати трёх");
+        if (minute < 0 || minute > 59) return unknown(normalized, "Минуты должны быть от нуля до пятидесяти девяти");
+        return new Result(Action.SET_TIME, hour, minute, normalized, "");
+    }
+
+    private static Result unknown(String normalized, String error) {
+        return new Result(Action.UNKNOWN, -1, -1, normalized, error);
+    }
+
+    private static boolean containsAny(String value, String... variants) {
+        for (String variant : variants) if (value.equals(variant) || value.contains(variant)) return true;
+        return false;
+    }
+
+    private static String normalize(String value) {
+        if (value == null) return "";
+        return Normalizer.normalize(value.toLowerCase(Locale.ROOT), Normalizer.Form.NFD)
+                .replaceAll("\\p{M}+", "")
+                .replace('ё', 'е')
+                .replaceAll("[^а-яa-z0-9:. ]", " ")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+}
