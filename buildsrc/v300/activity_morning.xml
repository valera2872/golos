<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/morningBackButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="‹"
            android:textColor="@color/qd_text"
            android:textSize="27sp"
            app:cornerRadius="18dp"
            app:strokeColor="@color/qd_border" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="SOMNORI · УТРО"
            android:textColor="@color/qd_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/somnori_morning_card_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/morningScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Доброе утро"
                    android:textColor="@color/qd_text"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/morningScreenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Somnori сохранил вашу ночь"
                    android:textColor="@color/qd_muted"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/morningScreenSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:lineSpacingExtra="3dp"
                    android:text="0 снов · 0 записей"
                    android:textColor="@color/qd_dream"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/morningScreenProgram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Перед сном · —"
                    android:textColor="@color/qd_time"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/morningReviewProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Что-нибудь осталось от сна?"
                    android:textColor="@color/qd_on_night_muted"
                    android:textSize="12.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/morningAddDreamButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:minHeight="0dp"
                    android:text="Добавить сон голосом"
                    android:textAllCaps="false"
                    android:textColor="@color/qd_primary_dark"
                    android:textSize="12sp"
                    app:backgroundTint="@color/qd_primary"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_mic"
                    app:iconPadding="8dp"
                    app:iconTint="@color/qd_primary_dark" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Этой ночью"
                android:textColor="@color/qd_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Оригинальный голос, транскрипт и утренний разбор остаются вместе."
                android:textColor="@color/qd_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/morningEntriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/surface_glass_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Somnori замечает"
                    android:textColor="@color/qd_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Повторяющиеся признаки из уже разобранных снов. Чем больше ночей, тем полезнее эта карта."
                    android:textColor="@color/qd_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/morningSignsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Пока повторов нет. После утреннего разбора отмечайте необычные места, людей и события как признаки сна."
                    android:textColor="@color/qd_on_night_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/morningSignsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morningAllDreamsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:minHeight="0dp"
                android:text="Все сны"
                android:textAllCaps="false"
                android:textColor="@color/qd_dream"
                app:cornerRadius="18dp"
                app:strokeColor="@color/qd_dream" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morningAllNightsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:text="Архив ночей"
                android:textAllCaps="false"
                android:textColor="@color/qd_text"
                app:cornerRadius="18dp"
                app:strokeColor="@color/qd_border_bright" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
